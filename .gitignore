# ============================================================
# FOSS-Nav · .gitignore
# ============================================================
# 静态站点项目，无需 Node 依赖；此文件主要用于防止误提交
# 开发副产物（编辑器缓存、临时测试文件等）。

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 编辑器
.vscode/
.idea/
*.swp
*.swo
*~

# Node / 测试（如果有人本地运行测试）
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# 测试副产物
.rendered-dom.html
verify.mjs
preview-*.png
test-results/

# Jekyll 构建产物（即使加了 .nojekyll，也要忽略 _site 等）
_site/
.jekyll-cache/
.jekyll-metadata
Gemfile
Gemfile.lock

# 日志 / 临时
*.log
*.tmp
*.bak
